# Context Hygiene Ignore Rules for Antigravity & Aura Development

# Aura Worktrees, Runtime Logs & Ephemeral Traces
.aura/worktrees/
.aura/logs/
.aura/artifacts/
.aura/traces/

# Rust build artifacts
target/
**/*.rs.bk
*.rlib
pkg/

# Code Coverage and Profiling
coverage/
htmlcov/
.coverage
.coverage.*
*.profraw
*.profdata
lcov.info

# Python cache and virtual environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/

# MicroVM, Kernel & Jailer artifacts
rootfs/
*.img
*.ext4
*.raw
*.microvm
firecracker.log
jailer.log
*.sock
jailer/
chroot/
*.tap
*.veth

# Knowledge graph and databases
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.db

# Node & package manager directories
node_modules/
.npm/

# Documentation build outputs
docs/_build/
site/
book/

# Logs and runtime diagnostics
*.log
.agents/audit.log

# OS & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
