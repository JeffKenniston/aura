{
  "version": "2.0",
  "hooks": [
    {
      "event": "PostToolUse",
      "matcher": {
        "tools": [
          "filesystem",
          "edit_file",
          "write_to_file",
          "patch_file"
        ],
        "pathPatterns": [
          "**/*.rs"
        ]
      },
      "action": {
        "type": "command",
        "command": "cargo fmt --check --quiet || cargo check --quiet",
        "failOnError": true,
        "description": "Deterministic Rust syntax and formatting validation via cargo"
      }
    },
    {
      "event": "PostToolUse",
      "matcher": {
        "tools": [
          "filesystem",
          "edit_file",
          "write_to_file",
          "patch_file"
        ],
        "pathPatterns": [
          "**/*.py"
        ]
      },
      "action": {
        "type": "command",
        "command": "ruff check --quiet . && ruff format --check --quiet .",
        "failOnError": true,
        "description": "Deterministic Python linting and formatting validation via ruff"
      }
    },
    {
      "event": "PostToolUse",
      "matcher": {
        "tools": [
          "filesystem",
          "edit_file",
          "write_to_file",
          "patch_file"
        ],
        "pathPatterns": [
          "**/*.rs",
          "**/*.py"
        ]
      },
      "action": {
        "type": "command",
        "command": "tree-sitter parse --quiet 2>/dev/null || true",
        "failOnError": false,
        "description": "Concrete Syntax Tree (CST) structural integrity verification"
      }
    },
    {
      "event": "PreToolUse",
      "matcher": {
        "tools": [
          "bash-sandbox",
          "browser-sandbox",
          "computer-sandbox"
        ]
      },
      "action": {
        "type": "command",
        "command": "test -c /dev/kvm",
        "failOnError": true,
        "description": "Verifies hardware virtualization device access prior to spawning Firecracker microVM"
      }
    },
    {
      "event": "PreToolUse",
      "matcher": {
        "tools": [
          "filesystem",
          "edit_file",
          "write_to_file"
        ]
      },
      "action": {
        "type": "command",
        "command": "test -S /run/spire/sockets/agent.sock || true",
        "failOnError": false,
        "description": "Verifies active SPIRE agent socket for zero-trust identity attestation"
      }
    }
  ]
}