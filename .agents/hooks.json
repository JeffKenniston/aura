{
  "version": "2.0",
  "hooks": [
    {
      "event": "PostToolUse",
      "matcher": {
        "tools": [
          "filesystem",
          "edit_file",
          "write_to_file",
          "patch_file"
        ],
        "pathPatterns": [
          "**/*.rs"
        ]
      },
      "action": {
        "type": "command",
        "command": "cargo fmt --check --quiet || cargo check --workspace --quiet",
        "failOnError": true,
        "description": "Deterministic Rust syntax and formatting validation across workspace"
      }
    },
    {
      "event": "PostToolUse",
      "matcher": {
        "tools": [
          "filesystem",
          "edit_file",
          "write_to_file",
          "patch_file"
        ],
        "pathPatterns": [
          "aura-cli/**/*.rs",
          "aura-cli/**/*.cedar"
        ]
      },
      "action": {
        "type": "command",
        "command": "cargo check --package aura-cli --quiet",
        "failOnError": true,
        "description": "Targeted compilation check for aura-cli"
      }
    },
    {
      "event": "PostToolUse",
      "matcher": {
        "tools": [
          "filesystem",
          "edit_file",
          "write_to_file",
          "patch_file"
        ],
        "pathPatterns": [
          "**/*.py"
        ]
      },
      "action": {
        "type": "command",
        "command": "ruff check --quiet . && ruff format --check --quiet .",
        "failOnError": true,
        "description": "Deterministic Python linting and formatting validation via ruff"
      }
    },
    {
      "event": "PreToolUse",
      "matcher": {
        "tools": [
          "bash-sandbox",
          "browser-sandbox",
          "computer-sandbox"
        ]
      },
      "action": {
        "type": "command",
        "command": "test -c /dev/kvm",
        "failOnError": true,
        "description": "Verifies hardware virtualization device access prior to spawning Firecracker microVM"
      }
    }
  ]
}