{
  "rust-validation": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_to_file|patch_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/rust-lint.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "condition": "args.command.includes('git commit') || args.command.includes('git push')",
        "hooks": [
          {
            "type": "command",
            "command": "cargo test && ./scripts/security-scan.sh",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "python-validation": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_to_file|patch_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/python-lint.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}